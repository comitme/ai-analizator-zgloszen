# Copy to .env and fill in. Never commit .env.

# Anthropic API key. Required for real classification.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# SQLAlchemy connection string.
# SQLite for local dev; swap for postgresql+psycopg://user:pass@host/db in production.
DATABASE_URL=sqlite:///./data/triage.db

# Offline mode: use a deterministic stub instead of the real LLM.
# Lets you run the API and UI without an API key and without spending money.
TRIAGE_FAKE_LLM=0
